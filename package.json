{
  "name": "vyrp",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint . && tsc -b",
    "lint:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets --features dev-tools -- -D warnings",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test",
    "check": "npm run lint && npm test && npm run lint:rust && npm run test:rust"
  },
  "dependencies": {
    "@tauri-apps/api": "~2.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.0.16",
    "vitest": "^5.0.5"
  },
  "description": "Ditado por voz para Windows (Tauri 2 + Rust + React/TS)"
}
