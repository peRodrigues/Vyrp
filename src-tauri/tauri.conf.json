{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vyrp",
  "version": "0.1.1",
  "identifier": "app.vyrp.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "hub",
        "title": "Vyrp",
        "url": "index.html",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "visible": false
      },
      {
        "label": "overlay",
        "title": "Vyrp overlay",
        "url": "overlay.html",
        "width": 280,
        "height": 56,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Vyrp",
    "shortDescription": "Ditado por voz para Windows",
    "longDescription": "Segure um atalho, fale e solte: o Vyrp transcreve localmente (whisper) e cola o texto no app em foco.",
    "category": "Productivity",
    "copyright": "© 2026 Vyrp",
    "createUpdaterArtifacts": false,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": [
          "pt-BR",
          "en-US"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJFQUI1MTY1NjExOTdDNkUKUldSdWZCbGhaVkdyTHBUdEZWSG1DaXR4M044M1UzcFhxM2tzMHYvSzg5MWEwRUx6MnNJNEQ3R3gK",
      "endpoints": [
        "https://github.com/peRodrigues/Vyrp/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
